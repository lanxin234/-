# 编译产物（可重新生成）
build/

# 上传的图片（内容寻址，可重新上传）
uploads/

# 运行时数据：链数据库 + 业务快照（含账号哈希，绝不提交）
data/

# 数据备份（体积大且含账号哈希，绝不提交）
backups/

# 运行日志
*.log

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量
.env
# 本机密钥配置（管理员密钥 / 邀请码），绝不提交
config.env

# 认证签名密钥（首次启动自动生成，绝不能提交）
.secret_key
backend/.secret_key

# IDE
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# 本地临时文件（启动脚本、调试输出）
.run_server.bat
.pscheck.txt
.launch.vbs
